# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Calendar OAuth (app-level credentials)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://studyclaw.com/connect/calendar/callback

# OpenAI (for semantic memory search embeddings — optional, falls back to full memory if unset)
OPENAI_API_KEY=sk-...

# Encryption key for storing tokens at rest (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
TOKEN_ENCRYPTION_KEY=...

# Web
WEB_BASE_URL=https://studyclaw.com
PORT=3000
